# Cursor
cursor-style = block
cursor-style-blink = false
adjust-cursor-height = -30%
cursor-text = #000000
mouse-hide-while-typing = true

# fonts
# font-size = 15

font-family = "FiraCode Nerd Font"
font-family-bold = "FiraCode Nerd Font, Bold"
font-family-italic = "FiraCode Nerd Font Mono"
font-family-bold-italic = "FiraCode Nerd Font Mono, Bold"

adjust-cell-width = 0%
adjust-cell-height = -8%

# Window
#gtk-single-instance = true
#gtk-wide-tabs = false
#window-padding-x = 5,5
#window-padding-y = 5,0
#window-padding-balance = true
#window-inherit-working-directory = false
#window-decoration = false
#window-theme = system
#confirm-close-surface = false
#resize-overlay = never
#quit-after-last-window-closed=false
#title = "Ghostty"
#window-subtitle = working-directory

# theming
theme = dark:Gruvbox Material Dark,light:Gruvbox Material Dark
# bold-color = bright

# Other
copy-on-select = clipboard
shell-integration-features = no-cursor,sudo,no-title
command = /usr/bin/nu

# keybindings
keybind = clear
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+comma=reload_config
keybind = ctrl+shift+a=select_all
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size

keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

keybind = ctrl+shift+h=new_split:left
keybind = ctrl+shift+j=new_split:down
keybind = ctrl+shift+k=new_split:up
keybind = ctrl+shift+l=new_split:right

keybind = alt+shift+h=goto_split:left
keybind = alt+shift+j=goto_split:down
keybind = alt+shift+k=goto_split:up
keybind = alt+shift+l=goto_split:right

# custom-shader = ./glitch.glsl
